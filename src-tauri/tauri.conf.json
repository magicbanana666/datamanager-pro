{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DataManager Pro",
  "version": "0.1.0",
  "identifier": "xyz.vanhulle.datamanagerpro",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DataManager Pro",
        "width": 1536,
        "height": 1024,
        "minWidth": 1280,
        "minHeight": 720,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Jonas Vanhulle",
    "copyright": "Copyright (c) 2026 Jonas Vanhulle",
    "category": "Utility",
    "shortDescription": "Analyze. Migrate. Manage. Your Data.",
    "longDescription": "DataManager Pro analyzes disks, folders and network shares, finds duplicates, compares and searches locations, and copies, moves and syncs data with a resumable journal.",
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZFRDg1NDhBOERDOTg3QjkKUldTNWg4bU5pbFRZYm1VcHJXcWc3aWF2cEJ2aytoeXhDeUxrYys2eGpDZEF2MCtqUWY2MkIwZDIK",
      "endpoints": [
        "https://github.com/magicbanana666/datamanager-pro/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
